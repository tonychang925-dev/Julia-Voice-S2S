#!/usr/bin/env bash
set -euo pipefail
mkdir -p /tmp/julia-voice-supervisor /var/log/julia /etc/julia /opt/julia/bin
CONF="${JULIA_VOICE_SUPERVISOR_CONF:-/etc/supervisor/conf.d/julia-voice.conf}"
PIDFILE="/tmp/julia-voice-supervisor/supervisord.pid"
LOG="/var/log/julia/bootstrap-supervisord.log"
if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  echo "julia voice supervisord already running pid=$(cat "$PIDFILE")"
else
  rm -f "$PIDFILE"
  setsid /usr/bin/supervisord -c "$CONF" >>"$LOG" 2>&1 < /dev/null &
  for _ in $(seq 1 20); do
    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "julia voice supervisord started pid=$(cat "$PIDFILE")"
      exit 0
    fi
    sleep 1
  done
  echo "julia voice supervisord failed to create pidfile" >&2
  tail -40 "$LOG" >&2 || true
  exit 1
fi
