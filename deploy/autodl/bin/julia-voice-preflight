require_path('python', os.environ.get('JULIA_S2S_PYTHON','/root/miniconda3/bin/python'), 'file')
require_path('console', os.environ.get('JULIA_S2S_CONSOLE','/root/miniconda3/bin/speech-to-speech'), 'file')
require_sha('base', release_path/'speech_to_speech/LLM/base_openai_compatible_language_model.py', os.environ.get('S2S_BASE_SHA256','2f904a05128d5b11c92e6a2bd04769cd12c6e06f3a66e7d23dbb09b7eb34004c'))
