#!/root/miniconda3/bin/python3
import hashlib, os, pathlib, sys

def sha(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for b in iter(lambda:f.read(1024*1024), b''):
            h.update(b)
    return h.hexdigest()

def require_path(label, path, kind='exists'):
    p=pathlib.Path(path)
    ok = p.exists() if kind=='exists' else p.is_file() if kind=='file' else p.is_dir()
    if not ok:
        raise SystemExit(f'PRECHECK FAIL {label}: missing {path}')
    return p

def require_sha(label, path, expected):
    p=require_path(label,path,'file')
    actual=sha(p)
    if actual != expected:
        raise SystemExit(f'PRECHECK FAIL {label}: sha mismatch {actual} != {expected}')

