# VOICE-EL-P0D-1 — Repository-defined experiment namespace contract.
#
# This file is the SINGLE SOURCE OF TRUTH for where an experiment is allowed to
# live and write. It is shipped inside the immutable artifact and is the only
# place these values are defined. Nothing may hand-write these paths on a server.
#
# Governing rule: VOICE SERVER IMMUTABILITY RULE v1
#   Repository = Source Authority / Server = Runtime Evidence
#   Runtime-generated state is permitted only in explicitly defined locations.
#
# Consequences encoded here:
#   * an experiment NEVER reads or writes the Golden `current` symlink
#   * an experiment NEVER writes generic scratch paths such as /tmp/manifest.json
#   * every root below is derived from the exact source SHA

EXPERIMENT_NAMESPACE_VERSION=1

# --- Roots. `%SHA%` expands to the exact 40-char source commit,
#     `%STAMP%` to a UTC build/deploy stamp supplied by the launcher. ---
EXPERIMENT_RELEASE_ROOT_TEMPLATE=/root/julia_voice_v2/releases/exp-%SHA%-%STAMP%
EXPERIMENT_RUN_ROOT_TEMPLATE=/root/julia_voice_v2/run/exp-%SHA%
EXPERIMENT_LOG_ROOT_TEMPLATE=/root/julia_voice_v2/logs/exp-%SHA%
EXPERIMENT_TMP_ROOT_TEMPLATE=/root/julia_voice_v2/tmp/exp-%SHA%

# --- Ports. Production holds :8765 (S2S) and :7860 (frontend); the experiment
#     must not collide with it. ---
EXPERIMENT_S2S_HOST=127.0.0.1
EXPERIMENT_S2S_PORT=8865
EXPERIMENT_FRONTEND_HOST=127.0.0.1
EXPERIMENT_FRONTEND_PORT=7960

# --- Interpreter. The production interpreter is used read-only; the experiment
#     never installs into it. ---
EXPERIMENT_PYTHON=/root/miniconda3/bin/python

# --- Declared compatibility envelope, asserted by the artifact's native gate. ---
EXPERIMENT_REQUIRED_PYTHON=3.10
EXPERIMENT_WEBSOCKETS_MIN=12
EXPERIMENT_WEBSOCKETS_MAX_EXCLUSIVE=16

# --- Secret interface (Workstream A: how a secret is READ is repository code;
#     only the VALUE is injected from the server's existing environment). ---
EXPERIMENT_API_KEY_ENV=ELEVENLABS_API_KEY
EXPERIMENT_VOICE_ID_ENV=ELEVENLABS_VOICE_ID

# --- Paths that an experiment must never touch. Colon-separated (PATH style) so
#     the file stays valid POSIX shell when sourced: a space-separated list would
#     be word-split and the shell would try to execute the extra words. ---
EXPERIMENT_FORBIDDEN_PREFIXES=/root/julia_voice_v2/releases/current:/root/miniconda3/lib/python3.10/site-packages:/opt/julia:/etc/julia
